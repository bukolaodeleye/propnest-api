{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm run build"
  },
  "deploy": {
    "preDeployCommand": "npm run db:migrate:deploy",
    "startCommand": "npm run start",
    "healthcheckPath": "/api/v1/health",
    "healthcheckTimeout": 100
  }
}
